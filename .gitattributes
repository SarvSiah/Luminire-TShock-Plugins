# Auto detect text files and perform LF normalization
* text=auto

# C# source
*.cs text diff=csharp
*.csproj text
*.sln text
*.props text
*.targets text
*.config text
*.json text
*.md text
*.yml text
*.yaml text
*.xml text

# Windows batch
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts
*.sh text eol=lf

# Images binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary

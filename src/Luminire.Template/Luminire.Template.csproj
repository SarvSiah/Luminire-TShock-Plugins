<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Description>Template for creating new Luminire TShock 6.1 plugins - copy this project to start your own plugin</Description>
    <Version>1.0.0</Version>
    <AssemblyName>Luminire.Template</AssemblyName>
    <RootNamespace>Luminire.Template</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TShock" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Luminire.Core\Luminire.Core.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
